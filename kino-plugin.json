{
  "id": "hentaila",
  "name": "Hentaila",
  "version": "1.1.3",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Hecho por Hotaru Yume Series y episodios hentai en español de hentaila.com: catálogo con Populares, Destacados y estrenos, géneros, búsqueda y varios servidores por episodio. Solo +18. Hecho por Hotaru Yume.",
  "author": "Hotaru Yume",
  "homepage": "https://github.com/protaxiogenao-oss/kino-plugin-HeemfntaiLA-main",
  "icon": "icon.png",
  "hosts": [
    "hentaila.com",
    "www.hentaila.com",
    "cdn.hentaila.com",
    "www.mp4upload.com",
    "mp4upload.com",
    "streamtape.com",
    "www.streamtape.com",
    "streamta.site",
    "www.streamta.site",
    "yourupload.com",
    "www.yourupload.com",
    "sendvid.com",
    "www.sendvid.com",
    "voe.sx",
    "www.voe.sx",
    "*.voe.sx"
  ],
  "streamHosts": "any",
  "browser": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "categories": [
    "anime",
    "adult"
  ],
  "color": "#E91E8C",
  "theme": {
    "accent": "#E91E8C",
    "onAccent": "#FFFFFF"
  },
  "settings": [
    {
      "key": "reproduccion",
      "label": "Reproducción",
      "type": "section",
      "hint": "Idioma y orden de los servidores de cada episodio."
    },
    {
      "key": "idioma",
      "label": "Idioma preferido",
      "type": "select",
      "default": "SUB",
      "hint": "Se prueban primero los servidores del idioma elegido.",
      "options": [
        {
          "value": "SUB",
          "label": "Subtitulado (VOSE)"
        },
        {
          "value": "DUB",
          "label": "Doblado (Latino o Español)"
        }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "voe",
      "hint": "Se prueba primero en cada episodio; si falla, se usan los demás.",
      "options": [
        {
          "value": "voe",
          "label": "Voe"
        },
        {
          "value": "mp4upload",
          "label": "MP4Upload"
        },
        {
          "value": "streamtape",
          "label": "Streamtape"
        },
        {
          "value": "yourupload",
          "label": "YourUpload"
        },
        {
          "value": "sendvid",
          "label": "SendVid"
        },
        {
          "value": "auto",
          "label": "Automático"
        }
      ]
    }
  ]
}
